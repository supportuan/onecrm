# Copy to deploy/compose/<slug>.env (not committed with secrets).
# Used by Docker Compose interpolation — not the app runtime file.

COMPOSE_PROJECT_NAME=onecrm-client
CONTAINER_NAME=onecrm-client
ENV_FILE=./deploy/clients/client.env
FRONTEND_PORT=3000
BACKEND_PORT=4000
IMAGE_NAME=onecrm
IMAGE_TAG=latest
