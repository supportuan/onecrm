# Unique-per-client keys. Copy Backend/.env.production.example, then overlay these.
# NEVER commit the filled file. NEVER reuse another client's DATABASE_URL or JWT_SECRET.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
JWT_SECRET="unique-long-random-secret"
FRONTEND_URL=https://crm.example.com
ORG_NAME=ClientName
PRODUCT_NAME=OneCRM
ORG_TAGLINE=Intelligence Connecting Seamlessly!
ORG_LOGO_URL=
ORG_WEBSITE_URL=https://www.example.com
LOGIN_HEADLINE=Your journey starts with a quick login
LOGIN_THEME=brand
LOGIN_THEME_LOCKED=false
SHOW_ALLIED_SERVICES=false
ADMIN_NOTIFICATION_EMAIL=ops@example.com
AWS_S3_PREFIX=client-slug
EMAIL_FROM="ClientName" <noreply@example.com>
# ENABLED_MODULES=HR,MARKETING,STUDENT_CRM,ADMIN
