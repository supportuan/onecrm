# Client D copy — overlay on Backend/.env.production.example
# Own database, JWT, S3 prefix, SMTP, and domain. Do not clone another client's data.

DATABASE_URL="postgresql://db_user:replace-with-url-encoded-password@db-host.example.com:5432/onecrm_d?sslmode=require"
JWT_SECRET="generate-a-long-random-secret-client-d-only"
FRONTEND_URL=https://crm.client-d.example
ORG_NAME=Client D
PRODUCT_NAME=OneCRM
ORG_TAGLINE=Intelligence Connecting Seamlessly!
ORG_LOGO_URL=
ORG_WEBSITE_URL=https://www.client-d.example
LOGIN_HEADLINE=Your journey starts with a quick login
LOGIN_THEME=mist
LOGIN_THEME_LOCKED=false
SHOW_ALLIED_SERVICES=false
ADMIN_NOTIFICATION_EMAIL=ops@client-d.example
AWS_S3_PREFIX=client-d
EMAIL_FROM="Client D <noreply@client-d.example>"
