# ApplyUniNow copy — overlay on Backend/.env.production.example
# Fill secrets locally. Do not reuse this database/JWT/S3 prefix for other clients.

DATABASE_URL="postgresql://db_user:replace-with-url-encoded-password@db-host.example.com:5432/onecrm_aun?sslmode=require"
JWT_SECRET="generate-a-long-random-secret-aun-only"
FRONTEND_URL=https://crm.applyuninow.com
ORG_NAME=ApplyUniNow
PRODUCT_NAME=OneCRM
ORG_TAGLINE=Intelligence Connecting Seamlessly!
ORG_LOGO_URL=/images/applyUniNow.png
ORG_WEBSITE_URL=https://applyuninow.com
LOGIN_HEADLINE=Your journey starts with a quick login
LOGIN_THEME=brand
LOGIN_THEME_LOCKED=false
SHOW_ALLIED_SERVICES=true
SHOW_SAMPLE_MODULES=true
ADMIN_NOTIFICATION_EMAIL=ops@applyuninow.com
AWS_S3_PREFIX=applyuninow
EMAIL_FROM="ApplyUniNow <noreply@applyuninow.com>"
