# Client B copy — overlay on Backend/.env.production.example
# Own database, JWT, S3 prefix, SMTP, and domain. Do not clone ApplyUniNow data.

DATABASE_URL="postgresql://db_user:replace-with-url-encoded-password@db-host.example.com:5432/onecrm_b?sslmode=require"
JWT_SECRET="generate-a-long-random-secret-client-b-only"
FRONTEND_URL=https://crm.client-b.example
ORG_NAME=Client B
PRODUCT_NAME=OneCRM
ORG_TAGLINE=Intelligence Connecting Seamlessly!
ORG_LOGO_URL=
ORG_WEBSITE_URL=https://www.client-b.example
LOGIN_HEADLINE=Your journey starts with a quick login
LOGIN_THEME=brand
LOGIN_THEME_LOCKED=false
SHOW_ALLIED_SERVICES=false
SHOW_SAMPLE_MODULES=false
ADMIN_NOTIFICATION_EMAIL=ops@client-b.example
AWS_S3_PREFIX=client-b
EMAIL_FROM="Client B <noreply@client-b.example>"
